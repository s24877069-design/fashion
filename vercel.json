{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "renufashionhub.in"
        }
      ],
      "destination": "https://www.renufashionhub.in/:path*",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/category/jewellery",
      "destination": "/category/jewelry",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/api/products",
      "destination": "/api/content?entity=products"
    },
    {
      "source": "/api/blogs",
      "destination": "/api/content?entity=blogs"
    },
    {
      "source": "/api/posts",
      "destination": "/api/content?entity=posts"
    },
    {
      "source": "/",
      "destination": "/api/seo-render?type=page&name=home"
    },
    {
      "source": "/about",
      "destination": "/api/seo-render?type=page&name=about"
    },
    {
      "source": "/blog",
      "destination": "/api/seo-render?type=page&name=blog"
    },
    {
      "source": "/contact",
      "destination": "/api/seo-render?type=page&name=contact"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/seo-render?type=page&name=privacy"
    },
    {
      "source": "/terms-of-service",
      "destination": "/api/seo-render?type=page&name=terms"
    },
    {
      "source": "/disclaimer",
      "destination": "/api/seo-render?type=page&name=disclaimer"
    },
    {
      "source": "/affiliate-disclosure",
      "destination": "/api/seo-render?type=page&name=affiliate"
    },
    {
      "source": "/cookie-policy",
      "destination": "/api/seo-render?type=page&name=cookie"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo-render?type=category&slug=:slug"
    },
    {
      "source": "/product/:id",
      "destination": "/api/seo-render?type=product&id=:id"
    },
    {
      "source": "/blog/:id",
      "destination": "/api/seo-render?type=blog&id=:id"
    },
    {
      "source": "/post/:id",
      "destination": "/api/seo-render?type=post&id=:id"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|ads\\.txt|.*\\..*).*)",
      "destination": "/api/seo-render?type=404"
    }
  ]
}
